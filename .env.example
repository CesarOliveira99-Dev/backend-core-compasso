PORT=4000
HOST=127.0.0.1
DATABASE_PATH=.data/compasso.sqlite
SEED_DEMO=false
NODE_ENV=development

# URLs HTTPS após publicar (PUBLIC_API_URL inclui /v1)
APP_URL=https://compasso-web.onrender.com
PUBLIC_API_URL=https://compasso-api.onrender.com/v1
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PAYMENTS_ENCRYPTION_KEY=
MP_SANDBOX=true
# Habilite somente após homologar assinaturas e webhooks. Preços vêm do catálogo no backend.
COMPASSO_SUBSCRIPTIONS_ENABLED=false
# Token da sua conta, exclusivamente para cobrar a assinatura do Compasso.
MP_PLATFORM_ACCESS_TOKEN=

# OAuth Client ID de aplicação Web, configurado no Google Auth Platform.
GOOGLE_CLIENT_ID=

# Opcional. Por padrão, mídia fica na pasta media ao lado do SQLite; use volume persistente.
# MEDIA_PATH=/data/media

# Email transacional (segredos apenas no painel do backend)
RESEND_API_KEY=
MAIL_FROM=
COMPASSO_RECOMMENDATION_PRICE_CENTS=0
MP_PLATFORM_USER_ID=

# Confirmações e lembretes de agendamento por Resend (desativado por padrão).
APPOINTMENT_EMAILS_ENABLED=false
